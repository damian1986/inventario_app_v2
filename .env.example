# Inventario Pro - Plantilla de variables de entorno
# Copia este archivo como .env y reemplaza los valores de ejemplo.
#   cp .env.example .env
# El archivo .env real NUNCA debe subirse al repositorio (ya está en .gitignore).

# --- Base de datos PostgreSQL ---
POSTGRES_USER=inventario
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=inventario_db

# --- Cadena de conexión para la API ---
# Dentro de Docker el host es "db"; para correr fuera de Docker usa "localhost".
DATABASE_URL=postgresql+asyncpg://inventario:cambia_esta_contrasena@db:5432/inventario_db

# --- Clave secreta para firmar tokens JWT ---
# Genera una nueva con:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=genera_una_clave_larga_y_aleatoria

# --- Contraseña inicial del usuario admin (opcional) ---
# Solo se usa la PRIMERA vez que arranca la API con la base de datos vacía.
# Si se deja vacía, se genera una aleatoria y se muestra UNA sola vez en los
# logs del contenedor (búscala y cámbiala al primer ingreso).
ADMIN_INITIAL_PASSWORD=

# --- Passkeys / WebAuthn (segundo factor opcional) ---
# WEBAUTHN_RP_ID: dominio sin puerto ni esquema. En local es "localhost";
#   en producción es tu dominio, p. ej. "inventario.tudominio.com".
# WEBAUTHN_RP_NAME: nombre visible que muestra el navegador al crear la passkey.
# WEBAUTHN_ORIGIN: origen(es) permitido(s), con esquema y puerto. Puede ser una
#   lista separada por comas. En local: http://localhost:3000 (y opcionalmente
#   http://127.0.0.1:3000). En producción: https://tu-dominio.
# NOTA: WebAuthn solo funciona en contexto seguro: localhost o HTTPS.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Inventario Pro
WEBAUTHN_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
